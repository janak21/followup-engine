# Locally, generate .env.local from the running stack (see the README):
#   supabase status -o env --override-name ... > dashboard/.env.local
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for dashboard -> Edge Function calls. Must match the
# internal_dispatch_key Vault secret and the functions' INTERNAL_DISPATCH_KEY.
INTERNAL_DISPATCH_KEY=local-dev-dispatch-key

# Production only. Signs the active-workspace cookie (falls back to the
# service role key in development).
# ACTIVE_TENANT_COOKIE_SECRET=
# Public base URL for journey webhooks (defaults to <supabase url>/functions/v1/journey-trigger).
# NEXT_PUBLIC_WEBHOOK_BASE_URL=
